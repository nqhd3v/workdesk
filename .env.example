# Supabase project: desk-bomb
# Server-only. Never prefix these with NEXT_PUBLIC_.
# Find them in Dashboard → Project Settings → API Keys (or `npx supabase status` for local)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=<sb_secret_...>

# Auth (single owner, TOTP)
# Random string, 32+ chars. Generate: openssl rand -base64 48
SESSION_SECRET=<random-32+-chars>
# Base32 TOTP secret. Leave empty, open /setup, scan the QR, then paste the value shown here.
TOTP_SECRET=
# IANA timezone used to display dates in the UI. Default: Asia/Ho_Chi_Minh
WORKDESK_TIMEZONE=Asia/Ho_Chi_Minh
